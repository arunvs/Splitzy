rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Basic profile info (email, displayName) used for the "add friend by
    // email" search. Any signed-in user can read any profile — that's an
    // inherent requirement of a client-only email lookup, not an oversight.
    // Only the owner can write their own profile.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // A friendship doc is jointly owned by its two participants: either one
    // can read it, and creating one requires the requester to be listed as
    // one of the two participants (so you can't forge a friendship between
    // two other people, or add yourself as someone's friend without them
    // being party to the write at all).
    match /friendships/{friendshipId} {
      // resource == null when the doc doesn't exist yet — our "already
      // friends?" check reads by ID before creating, so this must not error
      // on a missing document (Firestore rules throw if you dereference
      // resource.data on a null resource).
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid in resource.data.participants);
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.participants;
    }

    // Activity entries are readable only by their participants, writable
    // only by a participant, and immutable once created (no edit/delete —
    // it's a log).
    match /activity/{activityId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update, delete: if false;
    }

    // A group is readable/writable only by its current members. Creating one
    // requires the requester to be both the creator and one of the listed
    // members (so you can't forge a group you're not part of, or claim
    // authorship of a group you didn't create).
    match /groups/{groupId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.members &&
        request.auth.uid == request.resource.data.createdBy;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.members;
    }

    // An expense is readable/writable only by its participants. Creating one
    // requires the requester to be both the creator and one of the listed
    // participants — same shape as groups. Amount/split-sum correctness is
    // validated client-side (see src/lib/money.ts), not re-derived here;
    // these rules are access control, not business-logic validation.
    match /expenses/{expenseId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants &&
        request.auth.uid == request.resource.data.createdBy;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.participants;
    }

    // Best-effort client error logging: anyone can write (including from the
    // login screen, before auth exists), nobody can read back — these are
    // for us to inspect in the console, not for clients to query.
    match /errorLogs/{logId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
